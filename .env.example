# ==============================================================================
# .env.example - the complete set of environment variables this project reads
#
# Copy to `.env` for local development:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. This file is tracked,
# deliberately: it is the only place that records WHICH variables exist, and a
# reviewer without a running database still needs to know that.
#
# ------------------------------------------------------------------------------
# WHO READS THIS FILE
# ------------------------------------------------------------------------------
# This is important and frequently misunderstood, so it is stated explicitly:
#
#   * `docker compose` reads `.env` automatically for its OWN variable
#     substitutions (the POSTGRES_* block below).
#
#   * The application does NOT read `.env`. `Settings` is a pydantic-settings
#     model with no `env_file`, on purpose - a settings file introduces a second
#     source of truth whose precedence over the real environment is a reliable
#     generator of "works on my machine" failures. The application reads the
#     PROCESS environment only.
#
#   Therefore, to run the API or the worker on your host you must EXPORT these
#   values into your shell. Docker Compose does that for you when it starts a
#   container; it does not do it for a process you launch by hand.
#
#       # Git Bash / WSL / macOS / Linux
#       set -a && . ./.env && set +a
#
#       # PowerShell
#       Get-Content .env | Where-Object { $_ -and -not $_.StartsWith('#') } |
#           ForEach-Object { $n, $v = $_ -split '=', 2; Set-Item -Path "env:$n" -Value $v }
#
#       # or simply export the one variable that has no safe default:
#       export KA_DATABASE_URL=postgresql://ka:ka@localhost:5432/ka
#
# ------------------------------------------------------------------------------
# A TYPO IN A `KA_` VARIABLE IS A STARTUP ERROR, ON PURPOSE
# ------------------------------------------------------------------------------
# `Settings.model_config` sets `extra="forbid"`. An unrecognised `KA_`-prefixed
# variable is rejected at process start rather than silently ignored, because a
# misspelled `KA_LOG_LEVEL` that quietly does nothing is how a service ends up
# running at a log level nobody chose. If startup fails with an "extra inputs
# not permitted" error, this file is where to look.
#
# Every `KA_` variable below is a real field on `Settings`; tests/architecture/
# test_env_example.py asserts that in both directions, so this file cannot drift.
# That test also loads every assignment below through the real settings model, so
# a value that is syntactically fine but semantically rejected is caught here
# rather than on a new developer's machine.
#
# ------------------------------------------------------------------------------
# CREDENTIALS IN THIS FILE
# ------------------------------------------------------------------------------
# The password below is `ka`, matching the throwaway local-only role created by
# the PostgreSQL container. It is not a secret: it is a default for a database
# bound to loopback on a developer machine, and it is documented as such in
# docker-compose.yml. Anything resembling a real credential belongs in your
# untracked `.env` and nowhere else.
# ==============================================================================


# ==============================================================================
# 1. DOCKER COMPOSE - the local PostgreSQL + pgvector database
#
# Read by `docker compose` itself, not by the application. These values become
# the container's POSTGRES_* arguments.
# ==============================================================================

# Role created inside the container. Not a login role with SUPERUSER powers.
POSTGRES_USER=ka

# Throwaway local password. Override in your untracked `.env` if your machine's
# policy requires a stronger one; nothing else depends on this value.
POSTGRES_PASSWORD=ka

# Database the application connects to.
POSTGRES_DB=ka

# Host port mapped to the container's 5432. Change this if 5432 is already taken
# by a system PostgreSQL - and if you do, change KA_DATABASE_URL to match.
POSTGRES_PORT=5432


# ==============================================================================
# 2. APPLICATION - every field on `Settings`
#
# Grouped by the project's four configuration categories (see
# src/knowledge_assistant/config/categories.py). The category is not decoration:
# it determines whether the value may be logged, returned by /version, or shown
# in an error message.
#
# Values shown are the code defaults unless stated otherwise, so this file
# documents reality rather than describing an aspiration. Only KA_DATABASE_URL has
# no default - a missing database DSN is a startup failure by design, because
# there is no safe default database to fall back to.
# ==============================================================================


# --- PUBLIC ------------------------------------------------------------------
# Definition: safe to return to an unauthenticated caller. /version exposes
# exactly these two, which is why they are PUBLIC by category rather than merely
# "not secret".

KA_ENVIRONMENT=local
KA_SERVICE_NAME=knowledge-assistant


# --- SECRET ------------------------------------------------------------------
# Definition: a credential. Typed `SecretStr` in code so that printing the
# settings object is a type error rather than a disclosure.

# DSN for the PostgreSQL created by docker-compose.yml.
#
# Format note, verified against psycopg 3.3.6 and SQLAlchemy 2.1.3 on
# 2026-10-04: use the plain `postgresql://` scheme. psycopg REJECTS the
# SQLAlchemy-style `postgresql+psycopg://` scheme with a ProgrammingError,
# whereas SQLAlchemy 2.x resolves plain `postgresql://` to its psycopg (v3)
# dialect. Plain form is therefore the only spelling that both the application
# and `make migrate` accept.
KA_DATABASE_URL=postgresql://ka:ka@localhost:5432/ka


# --- SECURITY-SENSITIVE ------------------------------------------------------
# Definition: not a credential, but disclosing it degrades security - it widens
# an attack surface or reveals where an internal listener is.

# Interface the API binds. Loopback is the safe default: unreachable from the
# network. Production-safety validation REFUSES a loopback host when
# KA_ENVIRONMENT is staging or production.
KA_HOST=127.0.0.1

# Interface the Prometheus exporter binds. Kept separate from KA_HOST on purpose
# so metrics can stay loopback-only even when the API is exposed. Also refused
# when non-loopback in staging/production.
KA_METRICS_HOST=127.0.0.1

# Allowed origins, as a JSON array - NOT a comma-separated list, and NOT empty.
#
# `cors_allowed_origins` is typed `tuple[str, ...]`, and pydantic-settings parses
# complex-typed fields out of the environment as JSON before any field validator
# runs. Verified against pydantic-settings 2.15.0 on 2026-10-04:
#
#     KA_CORS_ALLOWED_ORIGINS=[]                        -> ()              works
#     KA_CORS_ALLOWED_ORIGINS=["http://localhost:3000"] -> ("http://...",) works
#     KA_CORS_ALLOWED_ORIGINS=                          -> SettingsError   CRASHES
#     KA_CORS_ALLOWED_ORIGINS=http://a,http://b         -> SettingsError   CRASHES
#
# The empty form is the important one: an empty string is NOT an empty list here,
# so it must be written `[]`. `[]` means "no cross-origin browser access", which is
# correct until a frontend is served from another origin.
#
# KNOWN DEFECT (reported, not fixed, in the dev-environment milestone): the
# `_split_origins` validator in config/settings.py documents itself as accepting a
# comma-separated string "so the variable is convenient in a container env". That
# behaviour is unreachable - the environment source fails first, as shown above.
# Only the JSON-array form actually works. The validator should either be deleted
# or the field retyped to match its documented intent.
KA_CORS_ALLOWED_ORIGINS=[]


# --- NON-SENSITIVE -----------------------------------------------------------
# Definition: operational configuration with no confidentiality requirement.

# --- HTTP ---
KA_PORT=8080

# Requests larger than this are refused before parsing. An unbounded body is a
# denial-of-service vector, so the limit is an explicit policy rather than a
# default inherited from the framework.
KA_MAX_REQUEST_BODY_BYTES=1048576

# --- database ---
KA_DB_POOL_MIN_SIZE=2
KA_DB_POOL_MAX_SIZE=10

# PostgreSQL's statement_timeout default is infinite, which turns one bad query
# into a pool-exhaustion outage. Set deliberately and low. The pool applies it to
# every connection it hands out.
KA_DB_STATEMENT_TIMEOUT_MS=5000

KA_DB_CONNECT_TIMEOUT_SECONDS=5

# --- worker ---
# How often an idle worker polls for a claimable job.
KA_WORKER_POLL_INTERVAL_SECONDS=1.0

# How long a claimed job is hidden from other workers before it is considered
# abandoned. Must exceed the longest expected handler runtime.
KA_WORKER_LEASE_SECONDS=30

# Attempts before a job is dead-lettered. Domain ceiling is 10; this is the
# application default of 3.
KA_WORKER_MAX_ATTEMPTS=3

KA_WORKER_BACKOFF_BASE_SECONDS=1.0
KA_WORKER_BACKOFF_CAP_SECONDS=300.0

# --- health ---
# Per-probe budget for readiness. A probe slower than this is reported failed
# rather than being allowed to hold the readiness check open.
KA_HEALTH_PROBE_TIMEOUT_SECONDS=2.0

# --- idempotency ---
# How long a completed idempotency key is honoured before the operation may be
# replayed as new.
KA_IDEMPOTENCY_RETENTION_SECONDS=86400

# --- observability ---
KA_LOG_LEVEL=info

# `json` for anything that ships logs to an aggregator; `console` is for reading
# a local terminal and is not machine-parseable.
KA_LOG_FORMAT=json

KA_METRICS_ENABLED=true
KA_METRICS_PORT=9100

# --- security ---
# Phase 1 has NO authentication implementation. This flag defaults to true so
# the AuthenticationBoundaryMiddleware fails closed (403) for every path outside
# its public allow-list. Setting it to false does not add authentication - it
# removes a guardrail, which is why production-safety validation refuses it.
KA_REQUIRE_AUTHENTICATION=true


# ==============================================================================
# 3. TESTS
# ==============================================================================

# Integration tests are skipped unless this is set, so the default `make test`
# lane runs with no database at all. Format is the same plain `postgresql://`
# scheme. Point it at a scratch database - the integration suite applies
# migrations, so never point it at a database holding data you care about.
# TEST_DATABASE_URL=postgresql://ka:ka@localhost:5432/ka_test